{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chuhe-xiangqi-online",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-20",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chuhe-xiangqi-db",
      "database_id": "00ad1875-48b0-42eb-9146-f0dd1b15476c",
      "migrations_dir": "drizzle"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ROOM_REALTIME", "class_name": "RoomRealtime" }
    ]
  },
  "exports": {
    "RoomRealtime": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "triggers": {
    "crons": ["17 */6 * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
